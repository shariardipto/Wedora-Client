# Copy to .env.local for local development. Never commit .env.local.
# Variables marked (Pn) are used from that build phase onward.
# Only NEXT_PUBLIC_* values reach the browser — never put secrets in them.

# --- Public URLs ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000

# --- Better Auth (P2) ---
# Generate a 32+ character secret, e.g.: npx @better-auth/cli secret
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- MongoDB (P2) — same database as the server ---
MONGODB_URI=
MONGODB_DB_NAME=wedora

# --- Google OAuth (P2) ---
# Authorized origin:  http://localhost:3000
# Redirect URI:       http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- ImgBB image hosting — used server-side only (profile photos, service images) ---
IMGBB_API_KEY=

# --- Admin account seed — read only by `npm run seed:admin` ---
# Admins can never sign up publicly; this script creates/repairs the account.
ADMIN_NAME=Wedora Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: password for the demo vendor/customer accounts created by `npm run seed:demo`.
# Leave empty to give them random passwords (they exist only to populate listings).
DEMO_PASSWORD=

# --- Home page background music (optional) ---
# Public URL of the audio file (e.g. a Cloudflare R2 bucket). Its host must allow this site's origins
# via CORS (GET, HEAD) so the player can keep the volume low on iPhones. Leave empty to hide the player.
NEXT_PUBLIC_MUSIC_URL=
